# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development (default)
DATABASE_URL=sqlite+aiosqlite:///./rewardiq.db
# OR Neon PostgreSQL connection string (use asyncpg driver)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/rewardiq?sslmode=require

# ── AI / Gemini ──────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# ── JWT Security ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# List allowed origins as a JSON array
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]
